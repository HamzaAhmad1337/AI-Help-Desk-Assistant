# Enables AI answers. Without it the app still runs end to end, answering
# directly from the knowledge base.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

PORT=3001
CLAUDE_MODEL=claude-sonnet-5
MAX_TOKENS=1024

# Comma-separated origin allowlist, or * to allow any.
# Set this to your real frontend origin in production.
ALLOWED_ORIGINS=*

# Per-IP rate limiting.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# Set ONLY when running behind a proxy or load balancer (e.g. 1 for a single
# hop). Left unset, the limiter uses the socket address. Enabling it when not
# actually behind a proxy lets callers spoof X-Forwarded-For to evade limits.
# TRUST_PROXY=1
